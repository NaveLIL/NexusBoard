# listening port
PORT=3000

# 32-byte hex key for AES-256 encryption (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MASTER_KEY=

# JWT signing secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# ntfy push url (optional)
NTFY_URL=
NTFY_TOPIC=nexusboard

# telegram bot (optional)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Express trust proxy (number of reverse proxy hops, or list of trusted IPs)
TRUST_PROXY=1
